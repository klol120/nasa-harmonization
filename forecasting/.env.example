# Optional credentials. Public historical country files/POWER/GEOS need no key.
# Protected bulk downloads accept a private token-file path; never put a token in git.
EARTHDATA_TOKEN_FILE=
FIRMS_MAP_KEY=
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Optional authenticated NASA raster sample downloads (environment only).
EARTHDATA_TOKEN=

# Serving requires an approved real operational artifact and its release manifest.
FIRECAST_MODEL=
FIRECAST_RELEASE=
FIRECAST_API_KEY=
