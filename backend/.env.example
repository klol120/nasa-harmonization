# Copy to .env and fill in. .env is git-ignored.
# PostgreSQL connection. The "firecal" database is created by `python -m firecal_api.cli init`.
# Homebrew on a Mac: postgresql://<your-mac-user>@127.0.0.1:5432/firecal (no password).
# Azure needs ?sslmode=require at the end.
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/firecal

# Folder holding one sub-folder per region export (lebanon/, greece/, eastmed/).
EXPORT_DIR=../pipeline/data/export

# Origins allowed to call the API from a browser (Vite dev server, Electron shell).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:47615

# Meteomatics weather API (only needed for `firecal-db weather-check` / `weather-fetch`).
METEOMATICS_USER=
METEOMATICS_PASSWORD=
METEOMATICS_DAILY_CAP=800

# ---- Accounts & business features (all optional; the data endpoints never need them) ----
# OAuth Client ID for "Sign in with Google" (not a secret). Empty = no Google button.
GOOGLE_CLIENT_ID=
# Local development only: test sign-in without Google + the /dev/outbox email preview. Never in production.
AUTH_DEV_LOGIN=0
# Used to build links in emails.
PUBLIC_WEB_URL=http://localhost:5173
PUBLIC_API_URL=http://127.0.0.1:8000
# Comma-separated emails that may read /admin/stats.
ADMIN_EMAILS=
# Real email sending. Without SMTP_HOST, emails stay in the outbox table.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Wel3a <no-reply@example.com>
# 0 for SMTP servers on port 465 / without STARTTLS.
SMTP_STARTTLS=1

# ---- Assistant (optional): the chat panel on the site ----
# Anthropic API key (https://console.anthropic.com/). Empty = the panel says it is not set up.
ANTHROPIC_API_KEY=
# Model the assistant uses, and how many questions the whole site may send per UTC day.
CHAT_MODEL=claude-haiku-5-5
CHAT_DAILY_CAP=2000
# Only for a key that belongs to a local gateway instead of api.anthropic.com, e.g. http://127.0.0.1:8317
# CHAT_BASE_URL=

# Docker image only (read by docker-entrypoint.sh, not by `serve`):
#   SKIP_INGEST=1    don't load EXPORT_DIR on start (Azure: data is loaded by hand)
#   WEATHER_FETCH=0  don't fetch Meteomatics weather on start
#   WEATHER_DIR      folder of weather-export JSON files to import on start

# Live pipeline (optional): near-real-time detections from NASA FIRMS, see backend/README.md.
# Free key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# Azure Event Hubs stream. Leave empty to handle events on this machine instead (same as --direct).
EVENTHUB_CONNECTION=
EVENTHUB_NAME=detections
