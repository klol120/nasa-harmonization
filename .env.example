# Copy to .env (next to docker-compose.yml) and fill in. .env is git-ignored: never commit it.

# Meteomatics weather API (hackathon account, valid until 2026-11-22). Only the api container sees these.
# Use single quotes if the password contains $ or other special characters.
METEOMATICS_USER=
METEOMATICS_PASSWORD=''
# Requests this deployment may send per UTC day. The account allows 1,000/day shared by everyone using it,
# so lower this if teammates fetch too.
METEOMATICS_DAILY_CAP=800
# Set to 0 to stop the api container fetching on start (e.g. after the account ends).
WEATHER_FETCH=1

# ---- Accounts, email list and alerts (all optional; the data works without them) ----
# OAuth Client ID for "Sign in with Google" (not a secret). Ask the team for it, or leave empty.
# The Google app must list http://localhost:<WEB_PORT> as an authorized JavaScript origin.
GOOGLE_CLIENT_ID=
# 1 = test sign-in without Google and the email preview at http://localhost:8010/dev/outbox. Local only.
AUTH_DEV_LOGIN=1
# Emails allowed to see admin stats in the account menu.
ADMIN_EMAILS=
# Real email sending. Leave SMTP_HOST empty to keep emails in the outbox (visible at /dev/outbox).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# ---- Assistant (optional): the chat panel on the site ----
# Anthropic API key (https://console.anthropic.com/). Only the api container sees it. Empty = the panel says it is not set up.
ANTHROPIC_API_KEY=
# Model the assistant uses, and how many questions the whole site may send per UTC day.
CHAT_MODEL=claude-haiku-5-5
CHAT_DAILY_CAP=2000
# Only for a key that belongs to a local gateway instead of api.anthropic.com. From the api container the
# host machine is host.docker.internal, e.g. http://host.docker.internal:8317
# CHAT_BASE_URL=

# Optional: host ports and database password.
# WEB_PORT=5173
# API_PORT=8010
# DB_PORT=5434
# POSTGRES_PASSWORD=firecal
