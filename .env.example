# Copy to .env (next to docker-compose.yml) and fill in. .env is git-ignored: never commit it.

# Meteomatics weather API (hackathon account, valid until 2026-11-22). Only the api container sees these.
# Use single quotes if the password contains $ or other special characters.
METEOMATICS_USER=
METEOMATICS_PASSWORD=''
# Requests this deployment may send per UTC day. The account allows 1,000/day shared by everyone using it,
# so lower this if teammates fetch too.
METEOMATICS_DAILY_CAP=800
# Set to 0 to stop the api container fetching on start (e.g. after the account ends).
WEATHER_FETCH=1

# Optional: host ports and database password.
# WEB_PORT=5173
# API_PORT=8010
# DB_PORT=5434
# POSTGRES_PASSWORD=firecal
